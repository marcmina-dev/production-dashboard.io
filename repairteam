<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950 text-slate-100">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ProTrack - Dark Production Dashboard</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Inter Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        darkbg: '#090d16',
                        darkcard: '#111827',
                        darkborder: '#1f2937',
                        cyanaccent: '#06b6d4',
                        purpleaccent: '#8b5cf6',
                    }
                }
            }
        }
    </script>
    <style>
        /* Custom scrollbar for dark view */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #090d16;
        }
        ::-webkit-scrollbar-thumb {
            background: #374151;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #4b5563;
        }
    </style>
</head>
<body class="h-full font-sans text-slate-200 antialiased flex flex-col md:flex-row overflow-hidden bg-slate-950">

    <!-- Toast Container -->
    <div id="toast-container" class="fixed top-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <!-- Mobile Navigation Overlay Drawer -->
    <div id="mobile-sidebar-backdrop" onclick="toggleMobileSidebar()" class="fixed inset-0 z-30 bg-slate-950/80 backdrop-blur-sm hidden md:hidden transition-opacity"></div>

    <!-- Sidebar Navigation -->
    <aside id="app-sidebar" class="fixed md:static inset-y-0 left-0 w-72 md:w-64 bg-slate-900 border-r border-slate-800 text-slate-300 flex-shrink-0 flex flex-col justify-between z-40 transform -translate-x-full md:translate-x-0 transition-transform duration-300 ease-in-out">
        <div>
            <!-- App Brand Header -->
            <div class="h-16 flex items-center justify-between px-4 sm:px-6 bg-slate-950 border-b border-slate-800 text-white font-bold text-xl tracking-wider">
                <div class="flex items-center gap-3 min-w-0">
                    <!-- Custom Team Logo Upload Container -->
                    <div class="relative group flex-shrink-0">
                        <div id="team-logo-display" onclick="triggerLogoUpload()" class="h-9 w-9 rounded-xl bg-slate-800 border border-slate-700 flex items-center justify-center text-cyan-400 overflow-hidden cursor-pointer shadow-md hover:border-cyan-400 transition" title="Click to upload team logo/picture">
                            <i class="fa-solid fa-wrench text-sm"></i>
                        </div>
                        <button onclick="triggerLogoUpload()" class="admin-only hidden absolute -bottom-1 -right-1 bg-cyan-500 text-slate-950 w-4 h-4 rounded-full flex items-center justify-center text-[9px] shadow" title="Upload Picture">
                            <i class="fa-solid fa-camera"></i>
                        </button>
                    </div>
                    <span class="text-xs sm:text-sm font-extrabold tracking-wide text-slate-100 truncate">Eastern Repair <span class="text-cyan-400">Team</span></span>
                </div>
                <!-- Hidden file input for team logo -->
    <input type="file" id="team-logo-input" accept="image/*" onchange="handleTeamLogoUpload(this)" class="hidden">
    <!-- Hidden file input for direct worker photo upload from directory cards -->
    <input type="file" id="worker-direct-photo-input" accept="image/*" onchange="handleDirectWorkerPhotoUpload(this)" class="hidden">
    <!-- Close Mobile Sidebar Button -->
                <button onclick="toggleMobileSidebar()" class="md:hidden text-slate-400 hover:text-white p-2">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            
            <!-- Navigation Links -->
            <nav class="p-4 space-y-1">
                <button onclick="switchTab('dashboard')" id="nav-dashboard" class="nav-btn w-full flex items-center gap-3 px-4 py-3 text-sm font-medium rounded-xl transition-all duration-200 bg-cyan-500 text-slate-950 font-semibold shadow-md shadow-cyan-500/10">
                    <i class="fa-solid fa-chart-pie w-5 text-center"></i>
                    <span>Dashboard</span>
                </button>
                <button onclick="switchTab('records')" id="nav-records" class="nav-btn w-full flex items-center gap-3 px-4 py-3 text-sm font-medium rounded-xl transition-all duration-200 hover:bg-slate-800 text-slate-400 hover:text-slate-200">
                    <i class="fa-solid fa-list-check w-5 text-center"></i>
                    <span>Production Logs</span>
                </button>
                <button onclick="switchTab('workers')" id="nav-workers" class="nav-btn w-full flex items-center gap-3 px-4 py-3 text-sm font-medium rounded-xl transition-all duration-200 hover:bg-slate-800 text-slate-400 hover:text-slate-200">
                    <i class="fa-solid fa-users w-5 text-center"></i>
                    <span>Personnel & Duty Days</span>
                </button>
                <button onclick="switchTab('directory')" id="nav-directory" class="nav-btn w-full flex items-center gap-3 px-4 py-3 text-sm font-medium rounded-xl transition-all duration-200 hover:bg-slate-800 text-slate-400 hover:text-slate-200">
                    <i class="fa-solid fa-address-card w-5 text-center"></i>
                    <span>Personnel Info</span>
                </button>
                <button onclick="switchTab('fleet')" id="nav-fleet" class="nav-btn w-full flex items-center gap-3 px-4 py-3 text-sm font-medium rounded-xl transition-all duration-200 hover:bg-slate-800 text-slate-400 hover:text-slate-200">
                    <i class="fa-solid fa-truck-front w-5 text-center"></i>
                    <span>Fleet Data</span>
                </button>
                <button onclick="switchTab('updates')" id="nav-updates" class="nav-btn w-full flex items-center gap-3 px-4 py-3 text-sm font-medium rounded-xl transition-all duration-200 hover:bg-slate-800 text-slate-400 hover:text-slate-200">
                    <i class="fa-solid fa-bullhorn w-5 text-center"></i>
                    <span>Advance Updates</span>
                </button>
            </nav>
        </div>

        <!-- Sidebar Footer Status -->
        <div class="p-4 border-t border-slate-800 text-xs text-slate-500 flex items-center justify-between">
            <span class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                System Dark Live
            </span>
            <span>v3.1.0</span>
        </div>
    </aside>

    <!-- Main Content Area -->
    <main class="flex-1 flex flex-col h-full overflow-hidden bg-slate-950 w-full">
        
        <!-- Top App Bar with Mobile Menu Toggle -->
        <header class="h-16 bg-slate-900 border-b border-slate-800 flex items-center justify-between px-4 sm:px-6 flex-shrink-0">
            <div class="flex items-center gap-3">
                <!-- Hamburger Menu Button for Mobile -->
                <button onclick="toggleMobileSidebar()" class="md:hidden text-slate-300 hover:text-white p-2 rounded-xl bg-slate-800 border border-slate-700">
                    <i class="fa-solid fa-bars text-base"></i>
                </button>
                <h1 id="page-title" class="text-base sm:text-xl font-bold text-slate-100 truncate">Dashboard Overview</h1>
            </div>
            <div class="flex items-center gap-2 sm:gap-3">
                <!-- Admin Security Lock Switch Button -->
                <button id="admin-toggle-btn" onclick="toggleAdminMode()" class="bg-slate-800 hover:bg-slate-700 text-amber-400 border border-amber-500/40 text-xs sm:text-sm font-semibold px-3 py-2 sm:px-4 sm:py-2 rounded-xl flex items-center gap-2 shadow-sm transition">
                    <i id="admin-lock-icon" class="fa-solid fa-lock"></i>
                    <span id="admin-toggle-text" class="hidden sm:inline">View Only Mode</span>
                </button>
                <button onclick="exportToCSV()" class="bg-emerald-600 hover:bg-emerald-500 text-white text-xs sm:text-sm font-semibold px-3 py-2 sm:px-4 sm:py-2 rounded-xl flex items-center gap-2 shadow-sm transition">
                    <i class="fa-solid fa-file-csv"></i>
                    <span class="hidden sm:inline">Export CSV</span>
                </button>
                <button onclick="openModal('production-modal')" class="admin-only hidden bg-cyan-500 hover:bg-cyan-400 text-slate-950 text-xs sm:text-sm font-bold px-3 py-2 sm:px-4 sm:py-2 rounded-xl flex items-center gap-2 shadow-sm shadow-cyan-500/20 transition">
                    <i class="fa-solid fa-plus"></i>
                    <span class="hidden sm:inline">Log Production</span>
                </button>
                <button onclick="openModal('worker-modal')" class="admin-only hidden bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs sm:text-sm font-semibold px-3 py-2 sm:px-4 sm:py-2 rounded-xl flex items-center gap-2 transition border border-slate-700">
                    <i class="fa-solid fa-user-plus"></i>
                    <span class="hidden sm:inline">Add Worker</span>
                </button>
            </div>
        </header>

        <!-- Dynamic Content Scroll View -->
        <div class="flex-1 overflow-y-auto p-3 sm:p-6 lg:p-8 space-y-4 sm:space-y-6">

            <!-- GLOBAL DATE FILTER / CALENDAR NAVIGATOR -->
            <div class="bg-slate-900 border border-slate-800 p-3 sm:p-4 rounded-2xl flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 shadow-lg">
                <div class="flex items-center gap-3">
                    <div class="p-2 sm:p-2.5 bg-slate-950 border border-slate-800 rounded-xl text-cyan-400 flex-shrink-0">
                        <i class="fa-solid fa-calendar-days text-base sm:text-lg"></i>
                    </div>
                    <div>
                        <span class="text-[10px] sm:text-xs font-semibold uppercase tracking-wider text-slate-400 block">Active Date View</span>
                        <span id="selected-date-display" class="text-xs sm:text-sm font-bold text-slate-100">All Dates (Historical)</span>
                    </div>
                </div>

                <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
                    <button onclick="navigateDate(-1)" class="flex-1 sm:flex-none px-2.5 py-1.5 bg-slate-950 hover:bg-slate-800 border border-slate-800 text-slate-300 rounded-xl text-xs font-semibold transition flex items-center justify-center gap-1">
                        <i class="fa-solid fa-chevron-left text-[10px]"></i> Prev
                    </button>
                    <input type="date" id="global-date-picker" onchange="handleDateSelect(this.value)" class="bg-slate-950 border border-slate-800 text-slate-200 px-2.5 py-1.5 rounded-xl text-xs font-medium focus:ring-2 focus:ring-cyan-500 focus:outline-none">
                    <button onclick="navigateDate(1)" class="flex-1 sm:flex-none px-2.5 py-1.5 bg-slate-950 hover:bg-slate-800 border border-slate-800 text-slate-300 rounded-xl text-xs font-semibold transition flex items-center justify-center gap-1">
                        Next <i class="fa-solid fa-chevron-right text-[10px]"></i>
                    </button>
                    <button onclick="setTodayDate()" class="px-2.5 py-1.5 bg-cyan-950 hover:bg-cyan-900 border border-cyan-800 text-cyan-300 rounded-xl text-xs font-bold transition">
                        Today
                    </button>
                    <button onclick="clearDateFilter()" class="px-2.5 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl text-xs font-medium transition">
                        Show All
                    </button>
                </div>
            </div>

            <!-- TAB 1: DASHBOARD VIEW -->
            <div id="tab-dashboard" class="tab-content space-y-4 sm:space-y-6">
                <!-- KPI Summary Cards Grid -->
                <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2.5 sm:gap-4">
                    <!-- Total Installs -->
                    <div class="bg-slate-900 p-3 sm:p-4 rounded-2xl border border-slate-800 shadow-sm flex items-center gap-2.5">
                        <div class="p-2.5 sm:p-3 bg-cyan-950 border border-cyan-800 text-cyan-400 rounded-xl flex-shrink-0">
                            <i class="fa-solid fa-download text-base sm:text-xl"></i>
                        </div>
                        <div class="min-w-0">
                            <p class="text-[9px] sm:text-[11px] font-semibold text-slate-400 uppercase tracking-wider truncate">Total Installs</p>
                            <h3 id="stat-total-installs" class="text-base sm:text-xl font-bold text-slate-100">0</h3>
                            <p id="stat-avg-installs" class="text-[9px] sm:text-[11px] text-slate-500 truncate">Avg 0 / log</p>
                        </div>
                    </div>
                    <!-- Total Restored -->
                    <div class="bg-slate-900 p-3 sm:p-4 rounded-2xl border border-slate-800 shadow-sm flex items-center gap-2.5">
                        <div class="p-2.5 sm:p-3 bg-purple-950 border border-purple-800 text-purple-400 rounded-xl flex-shrink-0">
                            <i class="fa-solid fa-rotate-left text-base sm:text-xl"></i>
                        </div>
                        <div class="min-w-0">
                            <p class="text-[9px] sm:text-[11px] font-semibold text-slate-400 uppercase tracking-wider truncate">Total Restored</p>
                            <h3 id="stat-total-restored" class="text-base sm:text-xl font-bold text-slate-100">0</h3>
                            <p id="stat-avg-restored" class="text-[9px] sm:text-[11px] text-slate-500 truncate">Avg 0 / log</p>
                        </div>
                    </div>
                    <!-- Daily Attendance -->
                    <div class="bg-slate-900 p-3 sm:p-4 rounded-2xl border border-slate-800 shadow-sm flex items-center gap-2.5">
                        <div class="p-2.5 sm:p-3 bg-teal-950 border border-teal-800 text-teal-400 rounded-xl flex-shrink-0">
                            <i class="fa-solid fa-clipboard-user text-base sm:text-xl"></i>
                        </div>
                        <div class="min-w-0">
                            <p class="text-[9px] sm:text-[11px] font-semibold text-slate-400 uppercase tracking-wider truncate">Attendance</p>
                            <h3 id="stat-total-attendance" class="text-base sm:text-xl font-bold text-slate-100 truncate">0 Present</h3>
                            <p id="stat-attendance-rate" class="text-[9px] sm:text-[11px] text-slate-500 truncate">100% Rate</p>
                        </div>
                    </div>
                    <!-- Total Duty Days -->
                    <div class="bg-slate-900 p-3 sm:p-4 rounded-2xl border border-slate-800 shadow-sm flex items-center gap-2.5">
                        <div class="p-2.5 sm:p-3 bg-indigo-950 border border-indigo-800 text-indigo-400 rounded-xl flex-shrink-0">
                            <i class="fa-solid fa-calendar-check text-base sm:text-xl"></i>
                        </div>
                        <div class="min-w-0">
                            <p class="text-[9px] sm:text-[11px] font-semibold text-slate-400 uppercase tracking-wider truncate">Duty Days</p>
                            <h3 id="stat-duty-days" class="text-base sm:text-xl font-bold text-slate-100">0</h3>
                            <p id="stat-duty-desc" class="text-[9px] sm:text-[11px] text-slate-500 truncate">Active days</p>
                        </div>
                    </div>
                    <!-- Active Personnel -->
                    <div class="bg-slate-900 p-3 sm:p-4 rounded-2xl border border-slate-800 shadow-sm flex items-center gap-2.5">
                        <div class="p-2.5 sm:p-3 bg-emerald-950 border border-emerald-800 text-emerald-400 rounded-xl flex-shrink-0">
                            <i class="fa-solid fa-users-gear text-base sm:text-xl"></i>
                        </div>
                        <div class="min-w-0">
                            <p class="text-[9px] sm:text-[11px] font-semibold text-slate-400 uppercase tracking-wider truncate">Active Workers</p>
                            <h3 id="stat-active-workers" class="text-base sm:text-xl font-bold text-slate-100">0</h3>
                            <p class="text-[9px] sm:text-[11px] text-slate-500 truncate">Staff</p>
                        </div>
                    </div>
                </div>

                <!-- TECHNICIAN DUTY & ATTENDANCE DASHBOARD BREAKDOWN CARD -->
                <div class="bg-slate-900 p-5 rounded-2xl border border-slate-800 shadow-sm space-y-4">
                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 pb-3 border-b border-slate-800">
                        <div>
                            <h2 class="text-base font-bold text-slate-100 flex items-center gap-2">
                                <i class="fa-solid fa-chart-column text-indigo-400"></i> Personnel Duty & Attendance Graph
                            </h2>
                            <p class="text-xs text-slate-400">Stacked attendance breakdown (Present, Absent, Rest Day, Vacation Leave, Sick Leave) per person</p>
                        </div>
                        <span class="text-xs bg-indigo-950 text-indigo-300 font-bold px-3 py-1 rounded-full border border-indigo-800">
                            Stacked Attendance View
                        </span>
                    </div>

                    <div class="h-80 sm:h-96">
                        <canvas id="chart-duty-attendance"></canvas>
                    </div>

                    <!-- Attendance Numerical Breakdown Summary Table -->
                    <div class="pt-4 border-t border-slate-800 space-y-2">
                        <span class="text-xs font-bold text-slate-200 uppercase tracking-wider block">Attendance Days Summary Breakdown</span>
                        <div class="overflow-x-auto rounded-xl border border-slate-800">
                            <table class="w-full text-left border-collapse text-xs">
                                <thead>
                                    <tr class="bg-slate-950 text-slate-400 border-b border-slate-800 font-semibold uppercase tracking-wider">
                                        <th class="py-2.5 px-3">Technician</th>
                                        <th class="py-2.5 px-3 text-center text-emerald-400">Present (Duty)</th>
                                        <th class="py-2.5 px-3 text-center text-rose-400">Absent</th>
                                        <th class="py-2.5 px-3 text-center text-slate-300">Rest Day</th>
                                        <th class="py-2.5 px-3 text-center text-cyan-400">Vacation Leave</th>
                                        <th class="py-2.5 px-3 text-center text-purple-400">Sick Leave</th>
                                        <th class="py-2.5 px-3 text-center text-amber-400">Total Logs</th>
                                    </tr>
                                </thead>
                                <tbody id="duty-attendance-table-body" class="divide-y divide-slate-800/60 text-slate-200">
                                    <!-- Dynamically populated in JavaScript -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Interactive Charts Section -->
                <div class="grid grid-cols-1 gap-6">
                    <!-- Daily Trend Line Chart -->
                    <div class="bg-slate-900 p-5 rounded-2xl border border-slate-800 shadow-sm">
                        <div class="flex justify-between items-center mb-4">
                            <h2 class="text-base font-bold text-slate-100">Daily Installs vs Restored Trend</h2>
                            <span class="text-xs text-slate-400">Daily Aggregates</span>
                        </div>
                        <div class="h-64 sm:h-72">
                            <canvas id="chart-daily-trend"></canvas>
                        </div>
                    </div>
                </div>

                <!-- Monthly Restore Breakdown Chart -->
                <div class="bg-slate-900 p-5 rounded-2xl border border-slate-800 shadow-sm space-y-4">
                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 pb-3 border-b border-slate-800">
                        <div>
                            <h2 class="text-base font-bold text-slate-100 flex items-center gap-2">
                                <i class="fa-solid fa-chart-column text-purple-400"></i> Monthly Restore Breakdown Chart
                            </h2>
                            <p class="text-xs text-slate-400">Monthly stacked restore output per Repair Team technician</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <span id="monthly-restore-leader-badge" class="text-xs bg-purple-950 text-purple-300 font-bold px-3 py-1 rounded-full border border-purple-800">
                                Leading: N/A
                            </span>
                            <span class="text-xs bg-slate-950 text-slate-300 font-bold px-3 py-1 rounded-full border border-slate-800">
                                Visual Chart View
                            </span>
                        </div>
                    </div>

                    <!-- Clean Visual Canvas Area -->
                    <div class="h-80 sm:h-96">
                        <canvas id="chart-monthly-restore"></canvas>
                    </div>

                    <!-- Personnel Legend placed cleanly at the bottom -->
                    <div class="pt-3 border-t border-slate-800">
                        <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider block mb-2">Repair Team Technicians</span>
                        <div id="monthly-restore-legend" class="flex flex-wrap items-center gap-2 text-xs">
                            <!-- Dynamic technician badges populated in JavaScript -->
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB 2: RECORDS / DATA TABLE VIEW -->
            <div id="tab-records" class="tab-content space-y-4 hidden">
                <!-- Table Controls (Filter & Search) -->
                <div class="bg-slate-900 p-4 rounded-2xl border border-slate-800 shadow-sm flex flex-col md:flex-row gap-4 items-center justify-between">
                    <!-- Search Input -->
                    <div class="relative w-full md:w-72">
                        <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-500 text-sm"></i>
                        <input type="text" id="table-search" placeholder="Search worker, notes..." oninput="renderTable()" class="w-full pl-10 pr-4 py-2 bg-slate-950 border border-slate-800 rounded-xl text-sm text-slate-200 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-cyan-500 transition">
                    </div>

                    <!-- Filters -->
                    <div class="flex flex-wrap items-center gap-3 w-full md:w-auto justify-end">
                        <select id="filter-status" onchange="renderTable()" class="bg-slate-950 border border-slate-800 text-sm text-slate-300 px-3 py-2 rounded-xl focus:outline-none focus:ring-2 focus:ring-cyan-500">
                            <option value="ALL">All Statuses</option>
                            <option value="Present">Present</option>
                            <option value="Absent">Absent</option>
                            <option value="Rest Day">Rest Day</option>
                            <option value="Vacation Leave">Vacation Leave</option>
                            <option value="Sick Leave">Sick Leave</option>
                        </select>
                        <select id="filter-worker" onchange="renderTable()" class="bg-slate-950 border border-slate-800 text-sm text-slate-300 px-3 py-2 rounded-xl focus:outline-none focus:ring-2 focus:ring-cyan-500">
                            <option value="ALL">All Workers</option>
                        </select>
                        <button onclick="clearAllData()" class="text-xs text-red-400 hover:text-red-300 font-semibold px-2 py-1 rounded hover:bg-red-950/50 transition" title="Clear all data">
                            <i class="fa-solid fa-trash-arrow-up mr-1"></i> Reset Data
                        </button>
                    </div>
                </div>

                <!-- Table Wrapper -->
                <div class="bg-slate-900 rounded-2xl border border-slate-800 shadow-sm overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse text-sm">
                            <thead>
                                <tr class="bg-slate-950 text-slate-400 border-b border-slate-800 font-semibold text-xs tracking-wider uppercase">
                                    <th class="py-3.5 px-4 cursor-pointer hover:text-slate-200" onclick="sortTable('date')">Date <i class="fa-solid fa-sort text-xs ml-1"></i></th>
                                    <th class="py-3.5 px-4 cursor-pointer hover:text-slate-200" onclick="sortTable('workerName')">Worker <i class="fa-solid fa-sort text-xs ml-1"></i></th>
                                    <th class="py-3.5 px-4 cursor-pointer hover:text-slate-200 text-teal-400" onclick="sortTable('attendance')">Attendance <i class="fa-solid fa-sort text-xs ml-1"></i></th>
                                    <th class="py-3.5 px-4 cursor-pointer hover:text-slate-200 text-cyan-400" onclick="sortTable('installs')">Installs <i class="fa-solid fa-sort text-xs ml-1"></i></th>
                                    <th class="py-3.5 px-4 cursor-pointer hover:text-slate-200 text-purple-400" onclick="sortTable('restored')">Restored <i class="fa-solid fa-sort text-xs ml-1"></i></th>
