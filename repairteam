        function handleDirectWorkerPhotoUpload(input) {
            if (!isAdminMode) {
                showToast('Admin Mode required to upload or edit photos!', 'error');
                return;
            }
            if (input.files && input.files[0] && activeDirectWorkerId) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const photoData = e.target.result;
                    const idx = workers.findIndex(w => w.id === activeDirectWorkerId);
                    if (idx !== -1) {
                        workers[idx].photo = photoData;
                        localStorage.setItem('protrack_workers', JSON.stringify(workers));
                        renderWorkers();
                        renderDirectory();
                        showToast(`Updated photo for ${workers[idx].name}!`, 'success');
                    }
                    input.value = '';
                    activeDirectWorkerId = null;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

