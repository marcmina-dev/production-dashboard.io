        // --- RECORDS TABLE RENDERER ---
        function renderTable() {
            const tbody = document.getElementById('records-tbody');
            const emptyMarker = document.getElementById('table-empty');
            if (!tbody) return;

            const searchVal = (document.getElementById('table-search')?.value || '').toLowerCase();
            const statusFilter = document.getElementById('filter-status')?.value || 'ALL';
            const workerFilter = document.getElementById('filter-worker')?.value || 'ALL';

            let list = records.filter(r => {
                if (selectedDate && r.date !== selectedDate) return false;
                if (statusFilter !== 'ALL' && r.attendance !== statusFilter) return false;
                if (workerFilter !== 'ALL' && r.workerName !== workerFilter) return false;
                if (searchVal) {
                    const matchWorker = (r.workerName || '').toLowerCase().includes(searchVal);
                    const matchNotes = (r.notes || '').toLowerCase().includes(searchVal);
                    if (!matchWorker && !matchNotes) return false;
                }
                return true;
            });

            // Sorting
            list.sort((a, b) => {
                let valA = a[sortConfig.field];
                let valB = b[sortConfig.field];
                if (typeof valA === 'string') valA = valA.toLowerCase();
                if (typeof valB === 'string') valB = valB.toLowerCase();
                if (valA < valB) return sortConfig.direction === 'asc' ? -1 : 1;
                if (valA > valB) return sortConfig.direction === 'asc' ? 1 : -1;
                return 0;
            });

            if (list.length === 0) {
                tbody.innerHTML = '';
                if (emptyMarker) emptyMarker.classList.remove('hidden');
                return;
            }

            if (emptyMarker) emptyMarker.classList.add('hidden');

            tbody.innerHTML = list.map(r => {
                const attBadge = r.attendance === 'Present' ? 'bg-emerald-950 text-emerald-400 border-emerald-800' :
                                 r.attendance === 'Absent' ? 'bg-rose-950 text-rose-400 border-rose-800' :
                                 r.attendance === 'Rest Day' ? 'bg-slate-800 text-slate-300 border-slate-700' :
                                 'bg-cyan-950 text-cyan-300 border-cyan-800';

                return `
                    <tr class="hover:bg-slate-800/50 transition">
                        <td class="py-3 px-4 font-medium text-slate-200">${r.date}</td>
                        <td class="py-3 px-4 font-bold text-slate-100">${r.workerName}</td>
