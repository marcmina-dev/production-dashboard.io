            const w = workers.find(item => item.id === id);
            if (!w) return;
            document.getElementById('edit-worker-id').value = w.id;
            document.getElementById('worker-name').value = w.name;
            document.getElementById('worker-role').value = w.role;
            document.getElementById('worker-dept').value = w.dept;
            document.getElementById('worker-photo').value = w.photo && w.photo.startsWith('http') ? w.photo : '';
