            localStorage.setItem('protrack_fleet', JSON.stringify(fleetVehicles));
            closeModal('fleet-modal');
            document.getElementById('fleet-form').reset();
            document.getElementById('edit-fleet-id').value = '';
            renderFleet();
            showToast('Fleet vehicle details saved!', 'success');
        }

        function editFleet(id) {
            const f = fleetVehicles.find(item => item.id === id);
            if (!f) return;
            document.getElementById('edit-fleet-id').value = f.id;
            document.getElementById('fleet-name').value = f.name;
            document.getElementById('fleet-plate').value = f.plate;
            document.getElementById('fleet-type').value = f.type || '';
            document.getElementById('fleet-fuel').value = f.fuel;
            document.getElementById('fleet-leader').value = f.leader || '';
            document.getElementById('fleet-status').value = f.status;
            openModal('fleet-modal');
        }

        function deleteFleet(id) {
            if (confirm('Delete this fleet vehicle entry?')) {
                fleetVehicles = fleetVehicles.filter(f => f.id !== id);
                localStorage.setItem('protrack_fleet', JSON.stringify(fleetVehicles));
                renderFleet();
                showToast('Vehicle removed from fleet', 'info');
            }
        }

        // --- ANNOUNCEMENTS / ADVANCE UPDATES ---
        function renderUpdates() {
            const grid = document.getElementById('updates-grid');
            if (!grid) return;

            grid.innerHTML = teamUpdates.map(u => `
                <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-2 relative group flex flex-col justify-between">
                    <div class="space-y-2">
                        <div class="flex justify-between items-start gap-2">
                            <h4 class="font-bold text-slate-100 text-sm">${u.title}</h4>
                            <span class="text-[10px] text-slate-500 font-mono flex-shrink-0">${u.date}</span>
                        </div>
                        <p class="text-xs text-slate-300 leading-relaxed">${u.content}</p>
                    </div>
                    <div class="pt-3 border-t border-slate-900 flex justify-end items-center">
                        <button onclick="deleteTeamUpdate('${u.id}')" class="admin-only ${isAdminMode ? '' : 'hidden'} text-xs bg-rose-950 hover:bg-rose-900 text-rose-300 font-semibold px-2.5 py-1 rounded-lg border border-rose-800 flex items-center gap-1.5 transition shadow-sm">
                            <i class="fa-solid fa-trash-can text-[11px]"></i> Delete Update
                        </button>
                    </div>
                </div>
            `).join('');
        }

        function handleSaveUpdate(e) {
            e.preventDefault();
            const update = {
                id: 'u_' + Date.now(),
                title: document.getElementById('update-title').value,
                content: document.getElementById('update-content').value,
                date: new Date().toISOString().split('T')[0]
            };
            teamUpdates.unshift(update);
            localStorage.setItem('protrack_updates', JSON.stringify(teamUpdates));
            closeModal('update-modal');
            document.getElementById('update-form').reset();
            renderUpdates();
            showToast('Announcement posted!', 'success');
        }

        function deleteTeamUpdate(id) {
            if (confirm('Delete this announcement?')) {
                teamUpdates = teamUpdates.filter(u => u.id !== id);
                localStorage.setItem('protrack_updates', JSON.stringify(teamUpdates));
                renderUpdates();
                showToast('Announcement removed', 'info');
            }
        }

        // --- SATURDAY - SUNDAY WEEKEND SCHEDULE ---
        function renderWeekendSchedule() {
            const grid = document.getElementById('weekend-schedule-grid');
            if (!grid) return;

            const saturdaySlots = weekendSchedule.filter(s => s.day === 'Saturday');
            const sundaySlots = weekendSchedule.filter(s => s.day === 'Sunday');

            const renderColumn = (slots, dayLabel) => `
                <div class="space-y-4">
                    ${slots.map((s, idx) => `
                        <div class="bg-slate-950 border border-slate-800 rounded-2xl p-4 flex flex-col items-center justify-center relative min-h-[300px]">
                            ${s.image ? `
                                <div class="w-full h-[500px] sm:h-[650px] overflow-hidden rounded-xl bg-slate-900 border border-slate-800 relative group flex items-center justify-center">
                                    <img src="${s.image}" class="w-full h-full object-contain">
                                    <div class="admin-only ${isAdminMode ? '' : 'hidden'} absolute top-3 right-3 flex items-center gap-2">
                                        <button onclick="openWeekendModalForSlot('${s.id}')" class="bg-slate-900/90 hover:bg-slate-800 text-slate-100 text-xs px-3 py-1.5 rounded-xl border border-slate-700 shadow">
                                            Change Photo
                                        </button>
                                        <button onclick="removeWeekendPhoto('${s.id}')" class="bg-rose-950/90 hover:bg-rose-900 text-rose-300 text-xs px-3 py-1.5 rounded-xl border border-rose-800 shadow">
                                            Remove Photo
                                        </button>
                                    </div>
                                </div>
                            ` : `
                                <div onclick="${isAdminMode ? `openWeekendModalForSlot('${s.id}')` : ''}" class="w-full h-48 border-2 border-dashed border-slate-800 hover:border-purple-500/50 rounded-xl flex flex-col items-center justify-center p-6 text-center transition cursor-pointer">
                                    <i class="fa-solid fa-cloud-arrow-up text-3xl text-slate-600 mb-2"></i>
                                    <span class="text-xs font-semibold text-slate-400">Upload Schedule Photo</span>
                                    <span class="text-[10px] text-slate-600 mt-1">${dayLabel} Snapshot</span>
                                </div>
                            `}
                        </div>
                    `).join('')}
                </div>
            `;

            grid.innerHTML = `
                ${renderColumn(saturdaySlots, 'Saturday')}
                ${renderColumn(sundaySlots, 'Sunday')}
            `;
        }

        function openWeekendModalForSlot(id) {
            const slot = weekendSchedule.find(s => s.id === id);
            if (!slot) return;
            document.getElementById('edit-weekend-id').value = slot.id;
            document.getElementById('weekend-day').value = slot.day;
            if (slot.image) {
                document.getElementById('weekend-image-data').value = slot.image;
                document.getElementById('weekend-image-preview').src = slot.image;
                document.getElementById('weekend-image-preview-container').classList.remove('hidden');
            } else {
                clearWeekendImagePreview();
            }
            openModal('weekend-schedule-modal');
        }

        function previewWeekendImage(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('weekend-image-data').value = e.target.result;
                    document.getElementById('weekend-image-preview').src = e.target.result;
                    document.getElementById('weekend-image-preview-container').classList.remove('hidden');
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function clearWeekendImagePreview() {
            document.getElementById('weekend-image-input').value = '';
            document.getElementById('weekend-image-data').value = '';
            document.getElementById('weekend-image-preview').src = '';
            document.getElementById('weekend-image-preview-container').classList.add('hidden');
        }

        function handleSaveWeekendSchedule(e) {
            e.preventDefault();
            const id = document.getElementById('edit-weekend-id').value;
            const day = document.getElementById('weekend-day').value;
            const imageData = document.getElementById('weekend-image-data').value;

            const idx = weekendSchedule.findIndex(s => s.id === id);
            if (idx !== -1) {
                weekendSchedule[idx].day = day;
                weekendSchedule[idx].image = imageData;
            } else {
                weekendSchedule.push({ id: 'w_' + Date.now(), day, image: imageData });
            }

            localStorage.setItem('protrack_weekend', JSON.stringify(weekendSchedule));
            closeModal('weekend-schedule-modal');
            renderWeekendSchedule();
            showToast('Weekend schedule photo saved!', 'success');
        }

        function removeWeekendPhoto(id) {
            const slot = weekendSchedule.find(s => s.id === id);
            if (slot) {
                slot.image = '';
                localStorage.setItem('protrack_weekend', JSON.stringify(weekendSchedule));
                renderWeekendSchedule();
                showToast('Schedule photo removed', 'info');
            }
        }

        // --- CSV EXPORTER ---
        function exportToCSV() {
            if (records.length === 0) {
                showToast('No production logs to export', 'error');
                return;
            }
            const headers = ['Date', 'Worker Name', 'Attendance', 'Installs', 'Restored', 'Total Units', 'Notes'];
            const rows = records.map(r => [
                `"${r.date}"`,
                `"${r.workerName}"`,
                `"${r.attendance}"`,
                r.installs || 0,
                r.restored || 0,
                r.totalUnits || ((r.installs || 0) + (r.restored || 0)),
                `"${(r.notes || '').replace(/"/g, '""')}"`
            ]);

            const csvContent = 'data:text/csv;charset=utf-8,' + [headers.join(','), ...rows.map(e => e.join(','))].join('\n');
            const encodedUri = encodeURI(csvContent);
            const link = document.createElement('a');
            link.setAttribute('href', encodedUri);
            link.setAttribute('download', `ProTrack_Production_Logs_${new Date().toISOString().split('T')[0]}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            showToast('CSV Export generated!', 'success');
        }

        // APP INITIALIZATION ON WINDOW LOAD
        window.onload = function() {
            renderTeamLogo();
            populateWorkerSelect();
            applyAdminUIState();
            switchTab('dashboard');
        };
    </script>
</body>
