        // --- DASHBOARD RENDERER & CHARTS ---
        function renderDashboard() {
            let filtered = records;
            if (selectedDate) {
                filtered = records.filter(r => r.date === selectedDate);
            }

            const totalInstalls = filtered.reduce((s, r) => s + (r.installs || 0), 0);
            const totalRestored = filtered.reduce((s, r) => s + (r.restored || 0), 0);
            const presentCount = filtered.filter(r => r.attendance === 'Present').length;
            const dutyDays = new Set(filtered.map(r => r.date)).size;

            document.getElementById('stat-total-installs').textContent = totalInstalls;
            document.getElementById('stat-total-restored').textContent = totalRestored;
            document.getElementById('stat-avg-installs').textContent = `Avg ${filtered.length ? (totalInstalls / filtered.length).toFixed(1) : 0} / log`;
            document.getElementById('stat-avg-restored').textContent = `Avg ${filtered.length ? (totalRestored / filtered.length).toFixed(1) : 0} / log`;
            document.getElementById('stat-total-attendance').textContent = `${presentCount} Present`;
            document.getElementById('stat-duty-days').textContent = dutyDays;
            document.getElementById('stat-active-workers').textContent = workers.length;

            renderCharts(filtered);
        }

        function renderCharts(filteredRecords) {
            // 1. Stacked Duty & Attendance Chart
            const ctxDuty = document.getElementById('chart-duty-attendance');
            if (ctxDuty) {
                const workerNames = workers.map(w => w.name);
                const presentData = workerNames.map(name => filteredRecords.filter(r => r.workerName === name && r.attendance === 'Present').length);
                const absentData = workerNames.map(name => filteredRecords.filter(r => r.workerName === name && r.attendance === 'Absent').length);
                const restData = workerNames.map(name => filteredRecords.filter(r => r.workerName === name && r.attendance === 'Rest Day').length);
                const vlData = workerNames.map(name => filteredRecords.filter(r => r.workerName === name && r.attendance === 'Vacation Leave').length);
                const slData = workerNames.map(name => filteredRecords.filter(r => r.workerName === name && r.attendance === 'Sick Leave').length);

                // Populate Numerical Summary Table below chart
                const summaryTbody = document.getElementById('duty-attendance-table-body');
                if (summaryTbody) {
                    summaryTbody.innerHTML = workerNames.map((name, i) => {
                        const totalLogs = presentData[i] + absentData[i] + restData[i] + vlData[i] + slData[i];
                        return `
                            <tr class="hover:bg-slate-800/40 transition">
                                <td class="py-2 px-3 font-semibold text-slate-100 truncate">${name}</td>
                                <td class="py-2 px-3 text-center font-bold text-emerald-400">${presentData[i]}</td>
                                <td class="py-2 px-3 text-center font-bold text-rose-400">${absentData[i]}</td>
                                <td class="py-2 px-3 text-center font-semibold text-slate-300">${restData[i]}</td>
                                <td class="py-2 px-3 text-center font-bold text-cyan-400">${vlData[i]}</td>
                                <td class="py-2 px-3 text-center font-bold text-purple-400">${slData[i]}</td>
                                <td class="py-2 px-3 text-center font-bold text-slate-100">${totalLogs}</td>
                            </tr>
                        `;
                    }).join('');
                }

                if (chartDutyAttendance) chartDutyAttendance.destroy();
                chartDutyAttendance = new Chart(ctxDuty, {
                    type: 'bar',
                    data: {
                        labels: workerNames,
                        datasets: [
                            { label: 'Present', data: presentData, backgroundColor: '#10b981' },
                            { label: 'Absent', data: absentData, backgroundColor: '#f43f5e' },
                            { label: 'Rest Day', data: restData, backgroundColor: '#64748b' },
                            { label: 'Vacation Leave', data: vlData, backgroundColor: '#06b6d4' },
                            { label: 'Sick Leave', data: slData, backgroundColor: '#8b5cf6' }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { labels: { color: '#94a3b8' } } },
                        scales: {
                            x: { stacked: true, ticks: { color: '#94a3b8' }, grid: { color: '#1e293b' } },
                            y: { stacked: true, ticks: { color: '#94a3b8' }, grid: { color: '#1e293b' } }
                        }
                    }
                });
            }

            // 2. Daily Trend Chart
            const ctxTrend = document.getElementById('chart-daily-trend');
            // 3. Monthly Restore Breakdown Chart (Synced with Production Logs per Repair Team member)
            const ctxMonthly = document.getElementById('chart-monthly-restore');
            if (ctxMonthly) {
                // Group production records by YYYY-MM
                const monthlyTotalsMap = {};
                const workerRestoreTotals = {};

                filteredRecords.forEach(r => {
                    if (r.date) {
                        const monthKey = r.date.substring(0, 7); // "YYYY-MM"
                        if (!monthlyTotalsMap[monthKey]) {
                            monthlyTotalsMap[monthKey] = {};
                        }
                        const restoredVal = parseInt(r.restored) || 0;
                        monthlyTotalsMap[monthKey][r.workerName] = (monthlyTotalsMap[monthKey][r.workerName] || 0) + restoredVal;
                        
                        // Accumulate overall restore total per technician for leadership calculation
                        workerRestoreTotals[r.workerName] = (workerRestoreTotals[r.workerName] || 0) + restoredVal;
                    }
                });

                // Find top performer for Restored Units
                let topRestorer = 'N/A';
                let topRestoreCount = 0;
                Object.entries(workerRestoreTotals).forEach(([wName, count]) => {
                    if (count > topRestoreCount) {
                        topRestoreCount = count;
                        topRestorer = wName;
                    }
                });

                const leaderBadge = document.getElementById('monthly-restore-leader-badge');
                if (leaderBadge) {
                    leaderBadge.textContent = topRestoreCount > 0 ? `Leading: 👑 ${topRestorer} (${topRestoreCount} restored)` : 'Leading: N/A';
                }

                // Sort month keys chronologically
                const sortedMonths = Object.keys(monthlyTotalsMap).sort();

                // Format labels for UI (e.g. "2026-03" -> "Mar 2026")
                const monthLabels = sortedMonths.map(mKey => {
                    const [year, month] = mKey.split('-');
                    const dateObj = new Date(parseInt(year), parseInt(month) - 1, 1);
                    return dateObj.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
                });

                // Unique color palette with 20 distinct high-contrast colors (one per technician, no repeats)
                const palette = [
                    '#8b5cf6', '#06b6d4', '#10b981', '#f59e0b', '#ec4899', 
                    '#3b82f6', '#14b8a6', '#f43f5e', '#a855f7', '#84cc16', 
                    '#eab308', '#f97316', '#0284c7', '#d946ef', '#10b981', 
                    '#6366f1', '#fb7185', '#38bdf8', '#a3e635', '#fb923c'
                ];

                const datasets = workers.map((w, idx) => {
                    const data = sortedMonths.map(mKey => (monthlyTotalsMap[mKey] && monthlyTotalsMap[mKey][w.name]) ? monthlyTotalsMap[mKey][w.name] : 0);
                    return {
                        label: w.name,
                        data: data,
                        backgroundColor: palette[idx % palette.length],
                        borderRadius: 4
                    };
                });

                // Render bottom legend list for listed names
                const legendContainer = document.getElementById('monthly-restore-legend');
                if (legendContainer) {
                    legendContainer.innerHTML = workers.map((w, idx) => {
