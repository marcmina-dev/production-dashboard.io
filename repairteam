        function handleSaveProduction(e) {
            e.preventDefault();
            const id = document.getElementById('edit-log-id').value;
            const record = {
                id: id || 'rec_' + Date.now(),
                date: document.getElementById('log-date').value,
                workerName: document.getElementById('log-worker').value,
                attendance: document.getElementById('log-attendance').value,
                installs: parseInt(document.getElementById('log-installs').value) || 0,
                restored: parseInt(document.getElementById('log-restored').value) || 0,
                notes: document.getElementById('log-notes').value
            };
            record.totalUnits = record.installs + record.restored;

            if (id) {
                const idx = records.findIndex(r => r.id === id);
                if (idx !== -1) records[idx] = record;
            } else {
                records.unshift(record);
            }

            localStorage.setItem('protrack_records', JSON.stringify(records));
            closeModal('production-modal');
            document.getElementById('production-form').reset();
            document.getElementById('edit-log-id').value = '';
            renderTable();
            renderDashboard();
            showToast('Production log saved successfully!', 'success');
        }

        function editRecord(id) {
            const rec = records.find(r => r.id === id);
            if (!rec) return;
            document.getElementById('edit-log-id').value = rec.id;
            document.getElementById('log-date').value = rec.date;
            document.getElementById('log-worker').value = rec.workerName;
            document.getElementById('log-attendance').value = rec.attendance;
            document.getElementById('log-installs').value = rec.installs;
            document.getElementById('log-restored').value = rec.restored;
            document.getElementById('log-notes').value = rec.notes || '';
            openModal('production-modal');
        }

