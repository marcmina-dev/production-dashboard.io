        // DIRECT PHOTO UPLOAD FROM CARD (LOCKED TO ADMIN ONLY)
        function triggerDirectWorkerPhotoUpload(workerId) {
            if (!isAdminMode) {
                showToast('Admin Mode required to upload or edit photos!', 'error');
                return;
            }
            activeDirectWorkerId = workerId;
            document.getElementById('worker-direct-photo-input').click();
