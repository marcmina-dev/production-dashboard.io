        function handleSaveWorker(e) {
            e.preventDefault();
            const id = document.getElementById('edit-worker-id').value;
            const name = document.getElementById('worker-name').value;
            const role = document.getElementById('worker-role').value;
            const dept = document.getElementById('worker-dept').value;
            const photo = document.getElementById('worker-photo-data').value || document.getElementById('worker-photo').value;

            if (id) {
                const idx = workers.findIndex(w => w.id === id);
                if (idx !== -1) {
                    workers[idx] = { id, name, role, dept, photo };
                }
            } else {
                workers.push({ id: 'w_' + Date.now(), name, role, dept, photo });
