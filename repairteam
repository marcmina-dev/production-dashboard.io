                        </td>
                        <td class="py-3 px-4 font-bold text-cyan-400">${r.installs}</td>
                        <td class="py-3 px-4 font-bold text-purple-400">${r.restored}</td>
                        <td class="py-3 px-4 font-extrabold text-slate-100">${r.totalUnits || (r.installs + r.restored)}</td>
                        <td class="py-3 px-4 text-right">
                            <div class="flex items-center justify-end gap-2">
                                <button onclick="editRecord('${r.id}')" class="admin-only ${isAdminMode ? '' : 'hidden'} text-xs bg-slate-800 hover:bg-slate-700 text-slate-200 px-2.5 py-1 rounded-lg border border-slate-700">
