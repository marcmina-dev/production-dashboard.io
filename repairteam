            if (confirm('Are you sure you want to remove this personnel profile?')) {
                const targetWorker = workers.find(w => w.id === id);
                if (targetWorker) {
                    // Remove worker's production records to sync all charts and totals
                    records = records.filter(r => r.workerName !== targetWorker.name);
